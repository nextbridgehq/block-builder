{
  "name": "@nextbridgehq/payload-block-builder",
  "version": "0.2.0",
  "description": "Block Builder for Payload CMS",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "cms",
    "block-builder",
    "dynamic-blocks"
  ],
  "homepage": "https://github.com/nextbridgehq/block-builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextbridgehq/block-builder.git"
  },
  "author": {
    "name": "NEXTBRIDGE LIMITED",
    "url": "https://github.com/nextbridgehq"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./builder.css": "./src/block-builder/builder.css",
    "./block-data-field.css": "./src/components/BlockDataField/BlockDataField.css",
    "./schema-builder-field.css": "./src/components/SchemaBuilderField/SchemaBuilderField.css"
  },
  "bin": {
    "payload-block-builder": "./dist/bin/init.js"
  },
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:encoding": "node scripts/check-encoding.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@payloadcms/ui": ">=3.0.0",
    "next": ">=14.0.0",
    "payload": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "immer": "^11.1.8",
    "lucide-react": "0.563.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "dompurify": "3.4.14",
    "esbuild": "0.28.1"
  }
}
