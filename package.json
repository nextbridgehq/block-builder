{
  "name": "@nextbridgehq/payload-block-builder",
  "version": "0.1.0",
  "description": "Payload v3 plugin — visual dynamic block builder with DB-driven schema versioning",
  "keywords": ["payload", "payload-plugin", "cms", "block-builder", "dynamic-blocks"],
  "homepage": "https://github.com/nextbridgehq/block-builder",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextbridgehq/block-builder.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./builder.css": "./src/block-builder/builder.css",
    "./block-data-field.css": "./src/components/BlockDataField/BlockDataField.css",
    "./schema-builder-field.css": "./src/components/SchemaBuilderField/SchemaBuilderField.css"
  },
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "payload": ">=3.0.0",
    "react": ">=18.0.0",
    "@payloadcms/ui": ">=3.0.0",
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "lucide-react": "0.563.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  }
}
